<footer class="bg-dark text-white py-5 mt-5">
  <div class="container">
    <div class="row">

      <!-- Coluna 1: Sobre o Blog -->
      <div class="col-md-4 mb-4 mb-md-0">
        <h5 class="text-uppercase mb-3">Sobre o Blog</h5>
        <p>
          Viajar é sobre lugares — mas também é sobre sabores. Entre um ponto turístico e outro, sempre cabe uma boa mesa. Siga com a gente nessa jornada de estradas, culturas e boa gastronomia.
        </p>
      </div>

      <!-- Coluna 2: Links Rápidos -->
      <div class="col-md-4 mb-4 mb-md-0">
        <h5 class="text-uppercase mb-4">Links Rápidos</h5>
        <ul class="list-unstyled">
          <li><%= link_to "Home", root_path, class: "text-decoration-none text-reset" %></li>
          <li><%= link_to "Posts", posts_path, , class: "text-decoration-none text-reset" %></li>
          <% if user_signed_in? %>
            <li><%= link_to "Meus Favoritos", favorites_path, , class: "text-decoration-none text-reset" %></li>
          <% end %>
        </ul>
      </div>

      <!-- Coluna 3: Redes Sociais e Contato -->
      <div class="col-md-4 mb-4 mb-md-0">
        <h5 class="text-uppercase mb-4">Siga-nos</h5>
        <div class="d-flex mb-3">
          <a href="https://facebook.com/seublog" target="_blank" class="text-white me-3">
            <i class="fab fa-facebook-f fa-lg"></i>
          </a>
          <a href="https://instagram.com/seublog" target="_blank" class="text-white me-3">
            <i class="fab fa-instagram fa-lg"></i>
          </a>
          <a href="https://twitter.com/seublog" target="_blank" class="text-white me-3">
            <i class="fab fa-twitter fa-lg"></i>
          </a>
          <a href="https://pinterest.com/seublog" target="_blank" class="text-white me-3">
            <i class="fab fa-pinterest-p fa-lg"></i>
          </a>
        </div>
        <hr class="my-4 border-secondary">
        <h5 class="text-uppercase mb-3">Contato</h5>
          <p>
            Tem uma sugestão, dúvida ou história para compartilhar?
            Envie uma mensagem para nós.
          </p>
          <p>
            <%= mail_to "contato@maishumblogdeviagem.com.br",
                "contato@maishumblogdeviagem.com.br" %>
          </p>
      </div>

    </div>

    <hr class="my-4 border-secondary">

    <!-- Direitos Autorais -->
    <div class="row">
      <div class="col-12 text-center">
        <p class="mb-0">&copy; <%= Time.current.year %> Mais Hum Blog de Viagem. Todos os direitos reservados.</p>
      </div>
    </div>

  </div>
</footer>
