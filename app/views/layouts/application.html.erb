<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " | Mais Hum Blog de Viagem" : "Mais Hum Blog de Viagem" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap" rel="stylesheet">

    <!-- Bootstrap (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-..." crossorigin="anonymous">

    <!-- CSS principal (inclui trix/actiontext via sprockets) -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Importmap para JS -->
    <%= javascript_importmap_tags %>

    <!-- Ícone da aba do navegador (Favicon) -->
    <%= favicon_link_tag 'favicon.png' %>
    <%= favicon_link_tag 'favicon.png', rel: 'apple-touch-icon', type: 'image/png' %>

    <!-- ... outros links e meta tags ... -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>

<body>
  <div class="container">
    <%# navbar %>
    <ul class="nav flex-column sticky-top bg-white">
      <li class="nav-item">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
        <%= image_tag "logo_humblog.png", alt: "Meu Blog", height: 125, class:"me-2", id:"logo_blog" %>
      <% end %>
      </li>
      <li class="nav-item">
        <nav class="navbar navbar-expand-lg">
          <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav me-auto d-xl-flex">
                <li class="nav-item"><%= link_to "Blog | Todas as postagens", posts_path, class: "nav-link" %></li>
              </ul>

              <ul class="navbar-nav">
                <% if user_signed_in? %>
                  <li class="nav-item d-flex align-items-center me-2">
                    <span class="nav-link">
                      Olá, <strong><%= current_user.name.presence || current_user.email %></strong>
                      <% if current_user.admin? %>
                        <span class="badge bg-danger ms-1">Admin</span>
                      <% end %>
                    </span>
                  </li>

                  <!-- Editar Perfil (todos usuários) -->
                  <% unless current_user.admin? %>
                    <li class="nav-item">
                      <%= link_to "Editar Perfil", edit_user_registration_path, class: "nav-link" %>
                    </li>
                  <% end %>

                  <!-- Favoritos (todos usuários) -->
                  <li class="nav-item">
                    <%= link_to favorites_path, class: "nav-link d-flex align-items-center" do %>
                      Favoritos
                      <% if current_user.favorite_posts.any? %>
                        <span class="badge bg-info text-dark ms-1"><%= current_user.favorite_posts.count %></span>
                      <% end %>
                    <% end %>
                  </li>

                  <% if current_user.admin? %>
                    <!-- Só admin vê esses -->
                    <li class="nav-item"><%= link_to "Novo Post", new_post_path, class: "nav-link" %></li>

                    <%= link_to my_posts_posts_path, class: "nav-link d-flex align-items-center" do %>
                      Meus Posts
                      <% if draft_posts_count.positive? %>
                        <span class="badge rounded-pill bg-warning text-dark"><%= draft_posts_count %></span>
                      <% end %>
                    <% end %>

                    <li class="nav-item">
                      <%= link_to pending_comments_path, class: "nav-link d-flex align-items-center" do %>
                        Comentários Pendentes
                        <% if Comment.pending.any? %>
                          <span class="badge bg-warning text-dark ms-1"><%= Comment.pending.count %></span>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>

                  <li class="nav-item">
                    <%= link_to "Sair", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
                  </li>
                <% else %>
                  <!-- Inline login form -->
                  <li class="nav-item">
                    <div class="d-xl-flex align-items-center">
                      <span class="me-2 nav-link">Já é usuário?</span>

                      <%= form_with url: user_session_path, scope: :user, local: true,
                                    html: { class: "d-xl-flex align-items-center m-auto", role: "form" } do |f| %>
                        <div class="me-2">
                          <%= f.email_field :email, placeholder: "email", class: "form-control form-control-sm  d-lg-flex", value: params.dig(:user, :email) %>
                        </div>
                        <div class="me-2 d-xl-flex">
                          <%= f.password_field :password, placeholder: "senha", class: "form-control form-control-sm" %>
                        </div>
                        <div class="me-2 d-none d-lg-block">
                          <%= f.check_box :remember_me, id: "remember_me", class: "form-check-input me-1" %>
                          <label for="remember_me" class="form-check-label small">Lembrar</label>
                        </div>
                        <div>
                          <%= f.submit "Entrar", class: "btn btn-primary btn-sm" %>
                        </div>
                      <% end %>

                      <div class="ms-xl-3 d-xl-flex">
                        <%= link_to "Cadastre-se", new_user_registration_path,
                                    class: "btn btn-outline-secondary btn-sm" %>
                      </div>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </nav>
      </li>
    </ul>
  <%# Flash messages %>
    <% flash.each do |type, message| %>
      <% alert_class = { "notice" => "success", "alert" => "danger", "warning" => "warning", "error" => "danger" }.fetch(type, "info") %>
      <div class="alert alert-<%= alert_class %> alert-dismissible fade show rounded-0 mb-0 text-center" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% end %>
    <%= yield %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
          crossorigin="anonymous"></script>
  <script type="text/javascript" src="https://unpkg.com/trix@2.0.0/dist/trix.umd.min.js"></script>
  <%= render 'layouts/footer' %>
</body>
</html>
