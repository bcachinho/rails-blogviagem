<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <h2 class="playfair_title_show text-center mb-4">Editar Perfil</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "p-4 border rounded shadow-sm" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-3">
        <%= f.label :name, "Nome", class: "form-label" %>
        <%= f.text_field :name, autofocus: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :email, "E-mail", class: "form-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-warning">
          Confirmação pendente para: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <hr class="my-4">

      <div class="mb-3">
        <%= f.label :password, "Nova senha", class: "form-label" %>
        <i class="text-muted small d-block mb-1">(deixe em branco se não quiser alterar)</i>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirme a nova senha", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :current_password, "Senha atual", class: "form-label" %>
        <i class="text-muted small d-block mb-1">(necessária para confirmar qualquer alteração)</i>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit "Atualizar", class: "btn btn-success" %>
      </div>
    <% end %>

    <hr class="my-4">

    <h5>Cancelar minha conta</h5>
    <p class="text-muted small">Essa ação é irreversível.</p>
    <%= button_to "Excluir minha conta", registration_path(resource_name),
                  data: { confirm: "Tem certeza que deseja excluir sua conta?" },
                  method: :delete, class: "btn btn-outline-danger btn-sm" %>

    <div class="mt-4 text-center">
      <%= link_to "← Voltar", :back %>
    </div>
  </div>
</div>
