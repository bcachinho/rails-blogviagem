<div class="card mb-4 shadow-sm">
  <% if post.display_cover.present? %>
    <%= link_to post_path(post) do %>
      <%= image_tag post.display_cover.variant(resize_to_fill: [1200, 400]).processed,
                    class: "card-img-top",
                    style: "object-fit:cover; height:300px;" %>
    <% end %>
  <% end %>

  <div class="card-body border-light">
    <h3 class="playfair_title_caroussel"><%= link_to post.title, post_path(post), class: "text-dark text-decoration-none" %></h3>

    <% if post.excerpt.present? %>
      <h5 class="text-muted playfair_subtitle_caroussel"><%= post.excerpt %></h5>
    <% end %>
    <hr>

    <% if post.content.present? %>
      <p class="card-text text-muted playfair_text">
        <%= truncate(strip_tags(post.content.to_plain_text), length: 200, separator: ' ') %>
        <%= link_to "Ler mais →", post_path(post), class: "btn btn-sm btn-outline-primary" %>
      </p>
    <% end %>



    <% if user_signed_in? %>
      <div class="mt-3"> <%# Adicionado div para espaçamento dos botões %>
        <% if current_user.favorite?(post) %>
          <%= button_to "★ Remover Favorito", post_favorite_path(post),
                        method: :delete, class: "btn btn-sm btn-outline-danger" %>
        <% else %>
          <%= button_to "☆ Favoritar", post_favorite_path(post),
                        method: :post, class: "btn btn-sm btn-outline-success" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card-footer bg-white">
    <% if post.published_at.present? %>
      <small class="text-muted">
        Publicado em <%= post.published_at.strftime("%d/%m/%Y") %>
        por <%= post.author&.name || "Autor desconhecido" %>
      </small>
    <% else %>
      <small class="text-muted">
        <em>Rascunho — criado em <%= post.created_at.strftime("%d/%m/%Y") %></em>
      </small>
    <% end %>
  </div>
</div>
